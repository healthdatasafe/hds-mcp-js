{
  "name": "hds-mcp",
  "version": "0.26.0",
  "description": "HDS MCP server for AI assistants (non-developer first): the hosted HDS connector (HTTP, OAuth, a URL to add) and the local server (stdio, Claude Desktop extension) that also imports records from files",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "hds-mcp": "dist/index.js",
    "hds-mcp-http": "dist/httpMain.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "start": "node src/index.ts",
    "start:http": "node src/httpMain.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "license": "source-licenser -c .licenser.yml .",
    "build:mcpb": "scripts/build-mcpb.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/healthdatasafe/hds-mcp-js.git"
  },
  "keywords": [
    "HDS",
    "Health",
    "Data",
    "Safe",
    "Pryv",
    "MCP",
    "Claude",
    "agent",
    "Model Context Protocol"
  ],
  "author": "Health Data Safe (https://www.healthdatasafe.org)",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/healthdatasafe/hds-mcp-js/issues"
  },
  "homepage": "https://github.com/healthdatasafe/hds-mcp-js#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "express": "^5.3.0",
    "open": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "neostandard": "^0.12.0",
    "source-licenser": "^2.0.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "optionalDependencies": {
    "hds-observability-js": "github:healthdatasafe/hds-observability-js"
  },
  "allowScripts": {
    "github:healthdatasafe/hds-observability-js": true
  }
}
